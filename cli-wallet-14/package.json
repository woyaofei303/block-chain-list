{
  "name": "cli-wallet-14",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "wallet": "node --env-file-if-exists=.env src/cli.ts",
    "test": "node --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "precommit": "lint-staged && npm run typecheck && npm test",
    "prepare": "cd .. && husky multi-chat-py-01/web/.husky"
  },
  "dependencies": {
    "ethers": "6.17.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.11",
    "@types/node": "24.13.6",
    "husky": "9.1.7",
    "lint-staged": "17.4.1",
    "typescript": "5.9.3"
  },
  "lint-staged": {
    "*.{ts,json}": "biome check --write --no-errors-on-unmatched"
  }
}
