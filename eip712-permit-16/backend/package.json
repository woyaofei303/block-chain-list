{
  "name": "tokenbank-backend",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/main.ts",
    "scan": "node --env-file-if-exists=.env src/main.ts --once",
    "test": "node --env-file-if-exists=.env --test test/*.test.ts",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "precommit": "lint-staged && npm run typecheck && npm test",
    "prepare": "cd ../.. && husky multi-chat-py-01/web/.husky",
    "test:integration": "node --test test/fullstack.integration.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "express": "5.2.1",
    "pg": "8.23.0",
    "viem": "2.56.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.11",
    "@types/express": "5.0.6",
    "@types/node": "24.13.6",
    "@types/pg": "8.23.1",
    "husky": "9.1.7",
    "lint-staged": "17.4.1",
    "typescript": "5.9.3"
  },
  "lint-staged": {
    "*.{ts,json}": "biome check --write --no-errors-on-unmatched"
  }
}
