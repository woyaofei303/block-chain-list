{
  "name": "erc20-event-indexer",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/main.mjs",
    "scan": "node --env-file-if-exists=.env src/main.mjs --once",
    "test": "node --env-file-if-exists=.env --test test/*.test.mjs",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "precommit": "lint-staged && npm test",
    "prepare": "cd .. && husky multi-chat-py/web/.husky"
  },
  "dependencies": {
    "express": "5.2.1",
    "pg": "8.23.0",
    "viem": "2.56.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.11",
    "husky": "9.1.7",
    "lint-staged": "17.4.1"
  },
  "lint-staged": {
    "*.{mjs,json}": "biome check --write --no-errors-on-unmatched"
  }
}
