{
  "name": "esrnt-storage-18",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "read": "node --env-file-if-exists=.env src/read-locks.ts",
    "test": "node --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "check": "npm run lint && npm run typecheck && npm test && forge fmt --check && forge build && forge test -vv",
    "precommit": "lint-staged && npm run typecheck && npm test && forge fmt --check && forge test",
    "prepare": "cd .. && husky multi-chat-py-01/web/.husky"
  },
  "dependencies": {
    "viem": "2.56.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.11",
    "@types/node": "24.13.6",
    "husky": "9.1.7",
    "lint-staged": "17.4.1",
    "typescript": "5.9.3"
  },
  "lint-staged": {
    "*.{ts,json}": "biome check --write --no-errors-on-unmatched"
  }
}
