{
  "name": "nft-market-subgraph-31",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "codegen": "graph codegen",
    "build": "graph build",
    "typecheck": "tsc --noEmit",
    "test": "graph test -v 0.6.0",
    "test:config": "node --test scripts/config.test.ts",
    "configure": "node scripts/configure.ts",
    "lint": "biome check .",
    "format": "biome check --write .",
    "check": "npm run lint && npm run codegen && npm run build && npm run typecheck && npm run test:config && npm test && forge fmt --check && forge test",
    "precommit": "lint-staged && npm run codegen && npm run build && npm run typecheck && npm run test:config && npm test && forge fmt --check && forge test",
    "prepare": "cd .. && husky multi-chat-py-01/web/.husky",
    "test:integration": "node --test scripts/local.integration.ts"
  },
  "dependencies": {
    "@graphprotocol/graph-ts": "0.38.2"
  },
  "devDependencies": {
    "@graphprotocol/graph-cli": "0.98.1",
    "matchstick-as": "0.6.0",
    "@biomejs/biome": "2.5.11",
    "@types/node": "24.13.6",
    "husky": "9.1.7",
    "lint-staged": "17.4.1",
    "typescript": "5.9.3"
  },
  "lint-staged": {
    "*.{ts,json,graphql}": "biome check --write --no-errors-on-unmatched"
  }
}
