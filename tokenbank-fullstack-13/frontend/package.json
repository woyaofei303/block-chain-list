{
  "name": "tokenbank-frontend",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mts",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "precommit": "lint-staged && pnpm typecheck && pnpm test",
    "prepare": "cd ../.. && husky multi-chat-py-01/web/.husky",
    "test:integration": "node --test tests/local.integration.mts"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.102.8",
    "next": "16.3.4",
    "p-queue": "9.3.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sonner": "2.0.8",
    "viem": "2.56.7",
    "wagmi": "3.7.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.11",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "husky": "9.1.7",
    "lint-staged": "17.4.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3"
  },
  "packageManager": "pnpm@11.21.0"
}
