# 已部署的 TokenBank 地址，也可以在页面“银行合约设置”中填写。
NEXT_PUBLIC_BANK_ADDRESS=
# 支持 Sepolia (11155111)、Base (8453)、本地 Anvil (31337)。
NEXT_PUBLIC_CHAIN_ID=11155111
# 留空则不显示浏览器链接；删除此行使用当前网络的默认区块浏览器。
NEXT_PUBLIC_EXPLORER_URL=https://sepolia.etherscan.io
# 仅本地链使用，需与浏览器钱包配置一致。
NEXT_PUBLIC_LOCAL_RPC_URL=http://127.0.0.1:8545
# 仅服务端使用，由 Next.js 在开发及生产环境代理到 Express。
INDEXER_URL=http://127.0.0.1:3001
